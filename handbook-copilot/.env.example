# Copy to .env and fill in what you need. All are optional.
# The app defaults to Ollama (local); paste an API key here or in the UI to switch.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama endpoint (default is fine if you installed it locally)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
